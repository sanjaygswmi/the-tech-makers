# ==========================================
# Application URLs
# ==========================================
# Base public API URL (e.g., https://your-preview-domain.vercel.app/api or http://localhost:3000/api)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Base frontend URL for canonical metadata & sitemaps (e.g., https://your-preview-domain.vercel.app or http://localhost:3000)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Server port (default 3000)
PORT=3000

# ==========================================
# Database & Authentication
# ==========================================
# MongoDB connection URI (e.g., your MongoDB Atlas connection string)
MONGODB_URI=your-mongodb-connection-string

# JWT signing secret for authentication tokens
JWT_SECRET=your-jwt-secret-key-change-me

# ==========================================
# CRM & Forms
# ==========================================
# HubSpot Private App Access Token for CRM contact capture
HUBSPOT_API_KEY=your-hubspot-token

# Google reCAPTCHA v2/v3 Site Key (public client-side key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Google reCAPTCHA Secret Key (private server-side verification)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Notification recipient email address for contact form enquiries
ADMIN_EMAIL=admin@example.com

# ==========================================
# SMTP Email Settings
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false

# ==========================================
# Rate Limiting (Optional - Upstash Redis)
# If omitted or unavailable, in-memory fallback is automatically used.
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
